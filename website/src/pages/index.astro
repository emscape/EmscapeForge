---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import PortfolioTeaser from '../components/home/PortfolioTeaser.astro';
import config from '../config';
---

<Layout
  title={config.site.title}
  description={config.site.description}
>
  <HeroSection />
  <ServiceCards />
  <PortfolioTeaser />

  <section class="cta-section">
    <div class="container">
      <h2>Ready to work together?</h2>
      <p>Whether you need a website built, documentation written, or a manuscript polished — let's talk.</p>
      <a href="/contact" class="button primary">Get in Touch</a>
    </div>
  </section>
</Layout>

<style lang="scss">
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    background-color: rgba(0, 0, 0, 0.02);

    .dark-mode & {
      background-color: rgba(255, 255, 255, 0.02);
    }

    h2 {
      font-size: 2rem;
      margin-bottom: 1rem;
    }

    p {
      font-size: 1.1rem;
      opacity: 0.8;
      margin-bottom: 2rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    .button {
      display: inline-block;
      padding: 0.9rem 2rem;
      border-radius: var(--border-radius-medium);
      font-weight: 600;
      text-decoration: none;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);

      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
      }

      &.primary {
        background-color: var(--color-primary);
        color: white;
      }
    }
  }
</style>
