---
import Layout from '../layouts/Layout.astro';
import config from '../config';
import { Image } from 'astro:assets';
import profilePic from '/public/images/profile.jpg';
---

<Layout
  title={`About — ${config.site.title}`}
  description="Emily is a Los Angeles-based developer and editor with 11+ years of experience in software, technical writing, and editorial work."
>
  <section class="about-page">
    <div class="container">
      <div class="about-header">
        <h1>About Me</h1>
        <div class="profile-image">
          <Image src={profilePic} alt="Profile picture of Emily" width={150} height={150} />
        </div>
      </div>
      
      <div class="about-content">
        <div class="bio">
          <h2>About Emily</h2>
          <p>
            I'm Emily, a Los Angeles-based developer, technical writer, and editor with over 11 years of experience
            in enterprise software, AI research, and application development. I founded EmscapeForge to offer
            the kind of careful, skilled work that larger agencies often can't — or won't — give to smaller clients.
          </p>
          <p>
            My background spans both sides of the communication divide: I can write the code and explain it clearly,
            design the system and document it, build the website and make sure every word on it earns its place.
            That combination is rare, and it's what I bring to every project.
          </p>
          <p>
            I've spent years as an Innovation Engineer and Application Developer at enterprise organizations,
            leading AI research, building proofs of concept, and creating training and documentation for technical
            and non-technical audiences alike. Outside of work, I've edited novels, built fan convention websites,
            and served as a Women Techmakers Ambassador and Google Developer Groups Organizer.
          </p>
        </div>

        <div class="skills">
          <h2>My Skills</h2>
          <div class="skills-grid skills-3-col"> {/* Adjusted class for potential styling */}
            <div class="skill-category">
              <h3>AI & Data</h3>
              <ul>
                <li>Generative AI</li>
                <li>Machine Learning</li>
                <li>SQL (MS SQL, T-SQL, Oracle)</li>
                <li>Business Rules</li>
              </ul>
            </div>

            <div class="skill-category">
              <h3>Technical Expertise</h3>
              <ul>
                <li>Technical Documentation</li>
                <li>Code Documentation</li>
                <li>Curriculum Development</li>
                <li>Cybersecurity Best Practices</li>
              </ul>
            </div>

            <div class="skill-category">
              <h3>Leadership & Communication</h3>
              <ul>
                <li>Agile Methodologies</li>
                <li>Technical Consulting</li>
                <li>Public Speaking</li>
                <li>Technology Integration</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="experience">
          <h2>Experience</h2>
          <div class="timeline">
            {/* Last 4 roles */}
            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>Application Developer, Consultant | Enterprise Architecture & Health Innovation Technology</h3>
                <p class="timeline-company">Stellarus</p>
                <p class="timeline-date">Jan 2025 - Present</p>
                <p>Research emerging tech, develop prototypes/POCs, create training, author EA/BA artifacts, deliver presentations.</p>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>Application Developer, Consultant | Enterprise Architecture & Health Innovation Technology</h3>
                <p class="timeline-company">Blue Shield of California</p>
                <p class="timeline-date">Jun 2022 - Dec 2024</p>
                <p>AI Tiger Team, research emerging tech, develop prototypes/POCs, create training, author EA/BA artifacts, deliver presentations.</p>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>Application Developer / Programmer Lead</h3>
                <p class="timeline-company">Populus Group (for Blue Shield of California)</p>
                <p class="timeline-date">Oct 2021 - Jun 2022</p>
                <p>Production support, troubleshooting, technical solution design, code streamlining, Confluence documentation.</p>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-marker"></div>
              <div class="timeline-content">
                <h3>Rules Analyst / Product Owner / Rules Developer</h3>
                <p class="timeline-company">SGS Technologie (for Guidewell Florida Blue)</p>
                <p class="timeline-date">Jun 2021 - Aug 2021</p>
                <p>Gather requirements, document rules, develop using Red Hat Decision Manager, Agile/Rally.</p>
              </div>
            </div>
            {/* Placeholder for "See More" button/logic */}
          </div>
        </div>

        <div class="cta">
          <h2>Work with me</h2>
          <p>
            Have a project in mind? I'd love to hear about it.
          </p>
          <div class="cta-buttons">
            <a href="/contact" class="button primary">Get in Touch</a>
            <a href="/services" class="button secondary">View Services</a>
            <a href={config.social.linkedin} target="_blank" rel="noopener noreferrer" class="button secondary">LinkedIn</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .about-page {
    padding: 2rem 0 4rem;
  }
  
  .about-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3rem;
    
    h1 {
      font-size: 3rem;
      margin: 0;
    }
  }
  
  .profile-image {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    overflow: hidden;
    
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .image-placeholder {
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text);
      opacity: 0.7;
      
      .dark-mode & {
        background-color: rgba(255, 255, 255, 0.05);
      }
    }
  }
  
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    
    h2 {
      font-size: 1.75rem;
      margin-top: 0;
      margin-bottom: 1.5rem;
      position: relative;
      
      &::after {
        content: '';
        position: absolute;
        bottom: -0.5rem;
        left: 0;
        width: 50px;
        height: 3px;
        background-color: var(--color-primary);
      }
    }
    
    p {
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 1.5rem;
      
      &:last-child {
        margin-bottom: 0;
      }
    }
  }
  
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .skill-category {
    h3 {
      font-size: 1.25rem;
      margin-top: 0;
      margin-bottom: 1rem;
      color: var(--color-primary);
    }
    
    ul {
      list-style-type: none;
      padding: 0;
      margin: 0;
      
      li {
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        
        .dark-mode & {
          border-bottom-color: rgba(255, 255, 255, 0.05);
        }
        
        &:last-child {
          border-bottom: none;
        }
      }
    }
  }
  
  .timeline {
    position: relative;
    
    &::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 15px;
      width: 2px;
      background-color: rgba(0, 0, 0, 0.1);
      
      .dark-mode & {
        background-color: rgba(255, 255, 255, 0.1);
      }
    }
  }
  
  .timeline-item {
    display: flex;
    margin-bottom: 2rem;
    
    &:last-child {
      margin-bottom: 0;
    }
  }
  
  .timeline-marker {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: var(--color-primary);
    margin-right: 1.5rem;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  
  .timeline-content {
    flex-grow: 1;
    
    h3 {
      font-size: 1.25rem;
      margin-top: 0;
      margin-bottom: 0.5rem;
    }
    
    .timeline-date {
      font-size: 0.9rem;
      color: var(--color-text);
      opacity: 0.7;
      margin-bottom: 0.75rem;
    }
  }
  
  .cta {
    text-align: center;
    padding: 2rem;
    background-color: rgba(0, 0, 0, 0.02);
    border-radius: var(--border-radius-large);
    
    .dark-mode & {
      background-color: rgba(255, 255, 255, 0.02);
    }
    
    h2 {
      &::after {
        left: 50%;
        transform: translateX(-50%);
      }
    }
    
    .cta-buttons {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    
    .button {
      display: inline-block;
      padding: 0.8rem 1.5rem;
      border-radius: var(--border-radius-medium);
      font-weight: 500;
      text-decoration: none;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);
      
      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
      }
      
      &.primary {
        background-color: var(--color-primary);
        color: white;
      }
      
      &.secondary {
        background-color: transparent;
        color: var(--color-text);
        border: 2px solid var(--color-primary);
      }
    }
  }
  
  @media (max-width: 768px) {
    .about-header {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    
    .about-content h2::after {
      left: 50%;
      transform: translateX(-50%);
    }
    
    .skills-grid {
      grid-template-columns: 1fr;
    }
    
    .timeline::before {
      left: 15px;
    }
  }
</style>