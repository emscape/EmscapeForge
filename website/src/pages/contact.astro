---
import Layout from '../layouts/Layout.astro';
import config from '../config';
const web3formsKey = config.contact.web3formsKey;
---

<Layout
  title={`Contact — ${config.site.title}`}
  description="Get in touch with Emily at EmscapeForge for web development, technical writing, or editorial services."
>
  <div class="contact-page">
    <div class="container">
      <header class="page-header">
        <h1>Get in Touch</h1>
        <p class="page-intro">
          Ready to start a project, or just want to see if we'd be a good fit? Send me a message and
          I'll get back to you within one business day.
        </p>
      </header>

      <div class="contact-layout">
        <div class="contact-form-wrapper">
          <form class="contact-form" id="contact-form" method="POST" action="https://api.web3forms.com/submit">
            <input type="hidden" name="access_key" value={web3formsKey} />
            <input type="hidden" name="subject" value="New contact from EmscapeForge" />
            <input type="checkbox" name="botcheck" style="display:none" />

            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required placeholder="Your name" />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required placeholder="your@email.com" />
            </div>

            <div class="form-group">
              <label for="service">Service you're interested in</label>
              <select id="service" name="service">
                <option value="">— Select one —</option>
                <option value="web-development">Web Development</option>
                <option value="technical-writing">Technical Writing & Documentation</option>
                <option value="copyediting">Copyediting & Proofreading</option>
                <option value="not-sure">Not sure yet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Tell me about your project</label>
              <textarea id="message" name="message" rows="6" required placeholder="What are you working on? What do you need help with?"></textarea>
            </div>

            <button type="submit" class="button primary" id="submit-btn">Send Message</button>

            <p class="form-result" id="form-success" hidden>
              Message sent! I'll be in touch within one business day.
            </p>
            <p class="form-result form-result--error" id="form-error" hidden>
              Something went wrong. Please try again or email me directly.
            </p>
          </form>
        </div>

        <aside class="contact-sidebar">
          <div class="sidebar-block">
            <h3>What happens next</h3>
            <ol>
              <li>I'll read your message and reply within one business day.</li>
              <li>If it sounds like a good fit, we'll schedule a short call to talk through your project.</li>
              <li>I'll put together a proposal with scope, timeline, and pricing.</li>
            </ol>
          </div>

          <div class="sidebar-block">
            <h3>Prefer email?</h3>
            <p>Reach me directly at <a href="mailto:emily@emscapeforge.com">emily@emscapeforge.com</a>.</p>
          </div>

          <div class="sidebar-block">
            <h3>Find me online</h3>
            <ul class="social-links">
              <li><a href={config.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
              <li><a href={config.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  .contact-page {
    padding: 3rem 0 5rem;
  }

  .page-header {
    margin-bottom: 3rem;

    h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }
  }

  .page-intro {
    font-size: 1.15rem;
    opacity: 0.8;
    max-width: 600px;
    line-height: 1.6;
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    label {
      font-size: 0.9rem;
      font-weight: 600;
    }

    input,
    select,
    textarea {
      padding: 0.75rem 1rem;
      border-radius: var(--border-radius-medium);
      border: 1px solid rgba(0, 0, 0, 0.15);
      background-color: var(--color-background);
      color: var(--color-text);
      font-size: 1rem;
      font-family: inherit;
      transition: border-color var(--transition-fast);

      .dark-mode & {
        border-color: rgba(255, 255, 255, 0.15);
      }

      &:focus {
        outline: none;
        border-color: var(--color-primary);
      }
    }

    textarea {
      resize: vertical;
      min-height: 140px;
    }
  }

  .button {
    display: inline-block;
    padding: 0.9rem 2rem;
    border-radius: var(--border-radius-medium);
    font-weight: 600;
    font-size: 1rem;
    font-family: inherit;
    cursor: pointer;
    border: none;
    text-decoration: none;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    align-self: flex-start;

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-medium);
    }

    &.primary {
      background-color: var(--color-primary);
      color: white;
    }
  }

  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sidebar-block {
    h3 {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.85rem;
    }

    p, li {
      font-size: 0.95rem;
      line-height: 1.6;
      opacity: 0.8;
    }

    ol {
      padding-left: 1.25rem;
      margin: 0;

      li {
        margin-bottom: 0.5rem;
      }
    }

    a {
      color: var(--color-primary);
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .social-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-result {
    font-size: 0.95rem;
    padding: 0.75rem 1rem;
    border-radius: var(--border-radius-medium);
    background-color: rgba(0, 180, 100, 0.1);
    color: var(--color-text);
    margin: 0;

    &--error {
      background-color: rgba(220, 50, 50, 0.1);
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const successMsg = document.getElementById('form-success') as HTMLElement;
  const errorMsg = document.getElementById('form-error') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    successMsg.hidden = true;
    errorMsg.hidden = true;

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form)
      });
      const data = await res.json();
      if (data.success) {
        form.reset();
        successMsg.hidden = false;
      } else {
        errorMsg.hidden = false;
      }
    } catch {
      errorMsg.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>
