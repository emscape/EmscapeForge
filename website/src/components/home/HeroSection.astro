---
---

<section class="hero-section">
  <div class="container">
    <div class="hero-content">
      <p class="hero-eyebrow">EmscapeForge</p>
      <h1 class="hero-title">
        Words, websites, and <span class="highlight">clarity</span> — built to last.
      </h1>
      <p class="hero-subtitle">
        Web development, technical writing, and editorial services for businesses and authors who care about getting it right.
      </p>
      <div class="hero-buttons">
        <a href="/services" class="button primary">See What I Do</a>
        <a href="/portfolio" class="button secondary">View My Work</a>
      </div>
    </div>
  </div>

  <div class="hero-background">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>
</section>

<style lang="scss">
  .hero-section {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 5rem 0 4rem;
  }

  .container {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-eyebrow {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;

    .highlight {
      color: var(--color-primary);
      position: relative;

      &::after {
        content: '';
        position: absolute;
        bottom: 0.1em;
        left: 0;
        width: 100%;
        height: 0.2em;
        background-color: var(--color-accent);
        opacity: 0.3;
        z-index: -1;
      }
    }
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    opacity: 0.8;
    max-width: 620px;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;

    .button {
      display: inline-block;
      padding: 0.85rem 1.75rem;
      border-radius: var(--border-radius-medium);
      font-weight: 600;
      text-decoration: none;
      transition: transform var(--transition-fast), box-shadow var(--transition-fast);

      &:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-medium);
      }

      &.primary {
        background-color: var(--color-primary);
        color: white;
      }

      &.secondary {
        background-color: transparent;
        color: var(--color-text);
        border: 2px solid var(--color-primary);
      }
    }
  }

  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .shape {
    position: absolute;
    border-radius: 50%;

    &-1 {
      width: 400px;
      height: 400px;
      background-color: var(--color-primary);
      opacity: 0.07;
      top: -150px;
      right: -100px;
    }

    &-2 {
      width: 600px;
      height: 600px;
      background-color: var(--color-secondary);
      opacity: 0.06;
      bottom: -300px;
      left: -200px;
    }

    &-3 {
      width: 250px;
      height: 250px;
      background-color: var(--color-accent);
      opacity: 0.08;
      top: 30%;
      right: 20%;
    }
  }
</style>
